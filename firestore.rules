rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('role', '') == 'Admin';
    }

    function isAgent() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('role', '') == 'Agent';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validation Helpers ---
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 200;
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 1000 &&
             data.read is bool &&
             data.createdAt is string &&
             data.type is string;
    }

    function isValidListingRequest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number;
    }

    function isValidDraft(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.title is string && data.title.size() <= 200;
    }

    function isValidProperty(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number;
    }

    function isValidChat(data) {
      return data.participants is list && data.participants.size() == 2 &&
             data.propertyId is string && data.propertyId.size() <= 128 &&
             data.propertyName is string && data.propertyName.size() <= 200 &&
             data.inspectionFeePaid is bool;
    }

    function isValidChatMessage(data) {
      return data.senderId is string && data.senderId.size() <= 128 &&
             data.receiverId is string && data.receiverId.size() <= 128 &&
             data.text is string && data.text.size() <= 5000 &&
             data.blocked is bool;
    }

    function isValidSupportTicket(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.category is string && (data.category == "Complaint" || data.category == "Suggestion" || data.category == "Partnership" || data.category == "Sponsorship" || data.category == "Partnership Enquiry" || data.category == "Sponsorship Enquiry" || data.category == "Complaints" || data.category == "Suggestions") &&
             data.details is string && data.details.size() <= 10000 &&
             data.createdAt is string;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isSignedIn();
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().get('role', 'Buyer') == 'Buyer' &&
                    incoming().get('tokens', 100) == 100 &&
                    incoming().get('kycStatus', 'None') == 'None' &&
                    incoming().get('isAgent', false) == false &&
                    incoming().get('isSubscriber', false) == false;

      allow update: if isAdmin() || (
        isOwner(userId) && isValidUser(incoming()) && (
          incoming().get('role', 'Buyer') != 'Admin' &&
          (incoming().get('kycStatus', 'None') == 'None' || incoming().get('kycStatus', 'None') == 'Pending' || incoming().get('kycStatus', 'None') == existing().get('kycStatus', 'None')) &&
          incoming().get('isSubscriber', false) is bool &&
          incoming().get('tokens', 0) is number && incoming().get('tokens', 0) >= 0 && incoming().get('tokens', 0) <= 100000
        )
      );

      allow delete: if isAdmin();

      // --- Notifications Subcollection ---
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        
        allow create: if isSignedIn() && isValidNotification(incoming()) && incoming().get('read', false) == false;
        
        allow update: if isOwner(userId) && isValidNotification(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['read']);
                      
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- Transactions Subcollection ---
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // --- Listing Requests (Pipeline) ---
    match /listingRequests/{requestId} {
      allow read: if isAgent() || isAdmin() || (isSignedIn() && (
        existing().get('ownerId', '') == request.auth.uid
      ));

      allow create: if (isAdmin() || (isSignedIn() && request.auth.uid == incoming().ownerId)) &&
                    isValidListingRequest(incoming()) &&
                    incoming().get('status', 'Pending') in ['Pending', 'Draft', 'Agent Bidding'];

      allow update: if isAdmin() || (
        isSignedIn() && isValidListingRequest(incoming()) && (
          // Case 1: Owner updates specific metadata
          (isOwner(existing().get('ownerId', '')) && 
           incoming().get('ownerId', '') == existing().get('ownerId', '') &&
           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'type', 'price', 'location', 'listingRequirements', 'dealStatus'])) ||
          
          // Case 2: Agent appends to agentBids array
          (isAgent() && 
           incoming().diff(existing()).affectedKeys().hasOnly(['agentBids']) && 
           incoming().get('agentBids', []).hasAll(existing().get('agentBids', [])) &&
           incoming().get('agentBids', []).size() <= 20)
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().get('ownerId', '')));
    }

    // --- Drafts (Workspace) ---
    match /drafts/{draftId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidDraft(incoming());
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && incoming().ownerId == request.auth.uid && isValidDraft(incoming());
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // --- Marketplace Properties ---
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProperty(incoming());
    }

    // --- Chats & Messages ---
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants && isValidChat(incoming());
      allow update: if isSignedIn() && request.auth.uid in existing().participants && isValidChat(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastTimestamp']) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['inspectionFeePaid']) && incoming().inspectionFeePaid == true)
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && 
                      request.auth.uid == incoming().senderId && 
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                      isValidChatMessage(incoming());
      }
    }

    // --- Disputes ---
    match /disputes/{disputeId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.agentId == request.auth.uid ||
        resource.data.raisedBy == request.auth.uid
      ));
      allow create: if isSignedIn() &&
                    request.auth.uid == incoming().raisedBy &&
                    incoming().get('status', 'Open') == 'Open' &&
                    isValidId(disputeId);
      allow update, delete: if isAdmin();
    }

    function isValidInspectionRequest(data) {
      return data.listingId is string && data.listingId.size() <= 128 &&
             data.buyerId is string && data.buyerId.size() <= 128 &&
             data.agentId is string && data.agentId.size() <= 128 &&
             data.status is string &&
             data.feeStatus is string;
    }

    // --- Inspection Requests ---
    match /inspectionRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.agentId == request.auth.uid || 
        isAdmin()
      );
      
      allow create: if isSignedIn() && 
                    request.auth.uid == incoming().buyerId &&
                    incoming().get('status', 'Pending') == 'Pending' &&
                    incoming().get('feeStatus', 'Pending') == 'Pending' &&
                    isValidInspectionRequest(incoming());
                    
      allow update: if isSignedIn() && isValidInspectionRequest(incoming()) && (
        isAdmin() ||
        (request.auth.uid == existing().buyerId && 
         incoming().diff(existing()).affectedKeys().hasOnly(['scheduledDate', 'timeSlot'])) ||
        (request.auth.uid == existing().agentId && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
      
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.agentId == request.auth.uid));
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 2000 &&
             data.createdAt is string;
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() && isValidAnnouncement(incoming());
    }

    // --- Support Tickets ---
    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.auth.uid == incoming().userId && isValidSupportTicket(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
